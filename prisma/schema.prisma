generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 注册用户（OAuth / 邮箱 / 用户名）；legacyOwnerKey 桥接匿名 Cookie 作品。
model User {
  id             String   @id @default(cuid())
  legacyOwnerKey String?  @unique
  /// 登录用户名（小写存储，唯一）
  username       String?  @unique
  email          String?  @unique
  phone          String?  @unique
  displayName    String?
  avatarUrl      String?
  /// scrypt 哈希（用户名/邮箱注册）；OAuth 用户可为空
  passwordHash   String?
  /// user | admin | super_admin
  role           String   @default("user")
  /// 裂变邀请码（分享链接 ?ref=）
  referralCode   String   @unique @default(cuid())
  referredById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// 可用生成额度（积分）；订阅月度额度另计
  quotaBalance           Int                @default(0)
  referredBy             User?              @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              User[]             @relation("UserReferrals")
  oauthAccounts          OAuthAccount[]
  sessions               UserSession[]
  quotaLedger            QuotaLedger[]
  referralRewardsGiven   ReferralReward[]   @relation("ReferrerRewards")
  referralRewardReceived ReferralReward?    @relation("InviteeReward")
  subscriptions          UserSubscription[]
  paymentEvents          PaymentEvent[]

  @@index([role])
}

/// 邮箱验证码（注册 / 找回密码）
model EmailVerification {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String    @default("register")
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

/// 额度流水（邀请奖励、购买、生成消耗）
model QuotaLedger {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  balanceAfter Int
  /// referral_signup | referral_invitee | purchase | generation_* | signup_bonus | admin_grant
  reason       String
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reason])
  @@index([createdAt])
}

/// 邀请裂变奖励（一次性的邀请关系记录）
model ReferralReward {
  id         String   @id @default(cuid())
  referrerId String
  inviteeId  String   @unique
  credits    Int
  createdAt  DateTime @default(now())

  referrer User @relation("ReferrerRewards", fields: [referrerId], references: [id], onDelete: Cascade)
  invitee  User @relation("InviteeReward", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

/// 套餐定义（free / creator / pro）
model SubscriptionPlan {
  id           String   @id
  name         String
  monthlyQuota Int
  priceCents   Int
  currency     String   @default("CNY")
  active       Boolean  @default(true)
  featuresJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions UserSubscription[]
}

/// 用户订阅周期
model UserSubscription {
  id            String   @id @default(cuid())
  userId        String
  planId        String
  /// active | cancelled | expired | pending
  status        String   @default("pending")
  periodStart   DateTime
  periodEnd     DateTime
  externalSubId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([periodEnd])
}

/// 支付订单 / Webhook 事件
model PaymentEvent {
  id          String    @id @default(cuid())
  userId      String?
  /// wechat | alipay | dev
  provider    String
  orderId     String    @unique
  amountCents Int
  currency    String    @default("CNY")
  /// pending | paid | failed | refunded
  status      String    @default("pending")
  planId      String?
  payloadJson String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([provider])
}

/// 异步任务（长生成迁移队列；单实例可用内存，多实例配 REDIS_URL）
model JobQueueItem {
  id          String   @id @default(cuid())
  /// novel_generate | comic_generate | cover_gen | ...
  type        String
  payloadJson String
  /// pending | running | done | failed
  status      String   @default("pending")
  attempts    Int      @default(0)
  lastError   String?
  runAfter    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAfter])
  @@index([type])
}

/// 统一创作项目：新内核的作品容器。旧 Project / Novel / Comic 在迁移期保持独立读取。
model CreativeProject {
  id         String   @id @default(cuid())
  ownerKey   String
  /// game | novel | comic
  kind       String
  title      String
  /// draft | generating | ready | review | published | failed
  status     String   @default("draft")
  /// private | pending_review | public | hidden
  visibility String   @default("private")
  /// 指向旧作品的迁移来源；不设数据库外键，允许按批次渐进迁移。
  legacyType String?
  legacyId   String?
  /// Author-confirmed immutable revision. Later generations must not move it implicitly.
  acceptedRevisionId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  revisions CreativeRevision[]
  artifacts CreativeArtifact[]
  jobs      GenerationJob[]
  evaluations CreativeEvaluation[]
  publications CreativePublication[]

  @@index([ownerKey, updatedAt])
  @@index([kind, visibility, updatedAt])
  @@unique([legacyType, legacyId])
  @@index([acceptedRevisionId])
  @@index([legacyType, legacyId])
}

/// 不可变创作版本。一条生成或一次作者确认编辑都创建一个新的 revision。
model CreativeRevision {
  id                String    @id @default(cuid())
  creativeProjectId String
  sequence          Int
  parentRevisionId  String?
  /// user_prompt | generate | refine | import | restore
  cause             String
  /// preparing | generating | ready | failed | superseded
  status            String    @default("preparing")
  intentJson        String?
  summary           String?
  createdAt         DateTime  @default(now())
  finalizedAt       DateTime?

  project   CreativeProject    @relation(fields: [creativeProjectId], references: [id], onDelete: Cascade)
  artifacts CreativeArtifact[]
  jobs      GenerationJob[]
  evaluations CreativeEvaluation[]
  publications CreativePublication[]

  @@unique([creativeProjectId, sequence])
  @@index([creativeProjectId, createdAt])
  @@index([parentRevisionId])
}

/// 版本化产物：正文、故事圣经、分镜、角色参考、游戏设计、构建物和媒体索引均可寻址。
model CreativeArtifact {
  id                 String   @id @default(cuid())
  creativeProjectId  String
  creativeRevisionId String?
  /// story_bible | outline | scene | manuscript | game_design | scene_graph | panel_plan | panel_image | asset_manifest | evaluation
  kind               String
  /// text | json | image | audio | binary | report
  mediaType          String
  /// pending | ready | failed | archived
  status             String   @default("ready")
  contentJson        String?
  textContent        String?
  storageUri         String?
  contentHash        String?
  provider           String?
  sourceArtifactId   String?
  metadataJson       String?
  /// Optional producer-owned idempotency key for singleton evidence artifacts.
  idempotencyKey     String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project  CreativeProject   @relation(fields: [creativeProjectId], references: [id], onDelete: Cascade)
  revision CreativeRevision? @relation(fields: [creativeRevisionId], references: [id], onDelete: SetNull)

  @@index([creativeProjectId, kind, createdAt])
  @@index([creativeRevisionId, kind])
  @@index([contentHash])
  @@index([sourceArtifactId])
}

/// 持久化、可租约、可重试的创作任务；替代请求内 SSE 和进程内后台任务作为最终执行语义。
model GenerationJob {
  id                 String    @id @default(cuid())
  creativeProjectId  String
  creativeRevisionId String?
  /// artifact_write | novel_plan | novel_scene | comic_panel | game_build | game_asset | evaluation
  type               String
  payloadJson        String
  /// queued | running | retrying | completed | failed | cancelled
  status             String    @default("queued")
  idempotencyKey     String?   @unique
  attempts           Int       @default(0)
  maxAttempts        Int       @default(3)
  runAfter           DateTime  @default(now())
  leaseExpiresAt     DateTime?
  workerId           String?
  lastErrorCode      String?
  lastErrorDetail    String?
  progressJson       String?
  outputArtifactId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?

  project  CreativeProject   @relation(fields: [creativeProjectId], references: [id], onDelete: Cascade)
  revision CreativeRevision? @relation(fields: [creativeRevisionId], references: [id], onDelete: SetNull)

  @@index([status, runAfter])
  @@index([creativeProjectId, createdAt])
  @@index([creativeRevisionId, createdAt])
  @@index([leaseExpiresAt])
}

/// Immutable, machine-readable quality decision for a concrete creator revision.
model CreativeEvaluation {
  id                 String    @id @default(cuid())
  creativeProjectId  String
  creativeRevisionId String?
  /// deterministic_quality | human_review | playtest
  evaluator          String
  /// ready | needs_polish | blocked
  verdict            String
  score              Int
  evidenceJson       String
  reportJson         String
  createdAt          DateTime  @default(now())

  project  CreativeProject   @relation(fields: [creativeProjectId], references: [id], onDelete: Cascade)
  revision CreativeRevision? @relation(fields: [creativeRevisionId], references: [id], onDelete: SetNull)

  @@index([creativeProjectId, createdAt])
  @@index([creativeRevisionId, createdAt])
  @@index([verdict, createdAt])
}

/// Append-only public-distribution decision. It never changes revision content.
model CreativePublication {
  id                 String    @id @default(cuid())
  creativeProjectId  String
  creativeRevisionId String?
  /// publish | unpublish
  action             String
  visibility         String
  /// approved | blocked
  decision           String
  qualityVerdict     String?
  qualityScore       Int?
  reasonJson         String?
  createdAt          DateTime  @default(now())

  project  CreativeProject   @relation(fields: [creativeProjectId], references: [id], onDelete: Cascade)
  revision CreativeRevision? @relation(fields: [creativeRevisionId], references: [id], onDelete: SetNull)

  @@index([creativeProjectId, createdAt])
  @@index([creativeRevisionId, createdAt])
  @@index([action, decision, createdAt])
}

/// Provider 级生成使用账本。绝不存 prompt、作品正文、密钥或原始 provider 响应。
model ProviderUsageEvent {
  id                  String   @id @default(cuid())
  /// llm | image | audio
  modality            String
  /// openai | openai_compatible | litellm | anthropic | gemini
  provider            String
  model               String
  /// json | text | image | image_batch | audio 等安全操作标签
  operation           String
  /// succeeded | failed
  status              String
  durationMs          Int
  outputUnits         Int?
  /// Provider 单价未知时保持 null，禁止用虚假成本计算毛利。
  estimatedCostMicros Int?
  errorCode           String?
  /// Optional durable job correlation. Null for foreground/non-job requests.
  generationJobId     String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([provider, model, createdAt])
  @@index([modality, status, createdAt])
  @@index([generationJobId, createdAt])
}

/// Last-mile provider reachability observations. Stores only safe metadata, never keys or response bodies.
model RuntimeProviderProbe {
  id         String   @id @default(cuid())
  providerId String
  ok         Boolean
  statusCode Int?
  outcome    String
  latencyMs  Int
  createdAt  DateTime @default(now())

  @@index([providerId, createdAt])
  @@index([createdAt])
}

/// 第三方登录绑定（微信 / QQ / 飞书 / Line / 抖音等）
model OAuthAccount {
  id             String    @id @default(cuid())
  userId         String
  /// wechat | qq | feishu | line | douyin | dev
  provider       String
  providerUserId String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  profileJson    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// 登录会话（HttpOnly gcreator_session）
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// 分享 / 裂变归因事件
model ShareEvent {
  id              String   @id @default(cuid())
  shareCode       String
  workType        String
  workId          String
  /// wechat | qq | feishu | line | douyin | copy | link | unknown
  channel         String   @default("unknown")
  referrerUserId  String?
  visitorOwnerKey String?
  createdAt       DateTime @default(now())

  @@index([shareCode])
  @@index([workId, workType])
  @@index([referrerUserId])
}

/// 匿名试玩质量事件。只记录模板、作品、时长与结果；不存提示词、输入内容或身份资料。
model GameplayEvent {
  id                 String   @id @default(cuid())
  /// 已保存作品时关联 Project id；创作台预览可为空。
  projectId          String?
  /// Exact immutable revision rendered by this browser session.
  creativeRevisionId String?
  templateId         String
  /// start | first_action | first_minute | end | retry
  event              String
  /// 每个浏览器试玩回合生成的随机 UUID，不与账户或设备标识关联。
  sessionId          String
  elapsedMs          Int?
  /// Foreground gameplay time, excluding hidden-tab time.
  activeMs           Int?
  /// Coarse action count only; raw input is never retained.
  actionCount        Int?
  /// mobile | desktop, derived without user-agent or fingerprint storage.
  deviceClass        String?
  /// portrait | landscape.
  orientation        String?
  touchCapable       Boolean?
  score              Int?
  won                Boolean?
  /// 生成时的静态首分钟质量分，便于校准质量评分与真实留存之间的关系。
  verticalSliceScore Int?
  /// Deduplicates retries without retaining any additional identity data.
  eventKey           String?  @unique
  createdAt          DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([creativeRevisionId, createdAt])
  @@index([templateId, event, createdAt])
  @@index([sessionId])
}

/// 匿名文学消费信号：随机 session，不保存正文、提示词、账号、IP 或设备指纹。
model LiteraryEngagementEvent {
  id        String   @id @default(cuid())
  workType  String
  workId    String
  sessionId String
  event     String
  /// chapter/page number; 0 for work-level start/complete events.
  unitIndex Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([workType, workId, sessionId, event, unitIndex])
  @@index([workType, workId, createdAt])
  @@index([createdAt])
}

/// 匿名创作者漏斗：随机浏览器会话与聚合阶段，不保存账号、作品内容、提示词、IP 或设备信息。
model CreatorFunnelEvent {
  id        String   @id @default(cuid())
  sessionId String
  /// visit | signup | create | publish
  event     String
  /// game | novel | comic; visit/signup use an empty string.
  workType  String   @default("")
  createdAt DateTime @default(now())

  @@unique([sessionId, event, workType])
  @@index([event, createdAt])
  @@index([createdAt])
}

/// 平台运行时配置（密钥加密存储；模型等可覆盖 product-config 默认值）
model PlatformRuntimeConfig {
  id              String   @id @default("default")
  /// AES-GCM 加密 JSON（API Key 等敏感字段）
  secretsEnc      String?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

/// 平台邮件配置（SMTP / Resend；密钥加密存储；后台可改，无需改 .env）
model PlatformEmailConfig {
  id              String   @id @default("default")
  configEnc       String?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

/// 后台治理审计
model AdminAuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  actorOwnerKey String?
  action        String
  targetType    String?
  targetId      String?
  detailJson    String?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

/// 访客或未来登录用户的作品容器；ownerKey 由 HttpOnly Cookie 持有，便于后续接入 OAuth 时迁移合并。
model Project {
  id                String   @id @default(cuid())
  ownerKey          String
  /// public | hidden | pending_review
  visibility        String   @default("public")
  featured          Boolean  @default(false)
  /// 可选短链 slug，用于 /s/[shareCode] 跳转试玩页
  shareCode         String?  @unique
  title             String
  prompt            String
  specJson          String
  status            String   @default("ready")
  /// 试玩首帧截图 URL 路径，如 /covers/{id}.jpg；由客户端截图后 PATCH 写入
  coverPath         String?
  /// 累计试玩次数（任何访客打开试玩页面时递增，不需要登录）
  playCount         Int      @default(0)
  /// 累计点赞数（访客通过 localStorage 去重，防止重复点）
  likeCount         Int      @default(0)
  /// 试玩页多回合 refine 日志 JSON（仅主人可读写入）
  refinementLogJson String?
  /// Creative Brief 结构化扩写 JSON（与 specJson 并列持久化）
  creativeBriefJson String?
  /// LLM 生成的旋律音符序列 JSON（无第三方 BGM API Key 时的降级方案，生成后缓存）
  bgmNotesJson      String?
  /// 音频模型实际产出的 BGM 资产元数据（URL / MIME / provider / model；不保存密钥）
  bgmAudioJson      String?
  /// 生成该作品规格时实际命中的服务商 ID（不含密钥）
  generationProvider String?
  /// 生成该作品规格时实际命中的模型 ID；本地规则回退记为 mock
  generationModel    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerKey])
  @@index([visibility, featured, playCount])
  @@index([visibility, createdAt])
}

model Novel {
  id                  String   @id @default(cuid())
  ownerKey            String
  visibility          String   @default("public")
  featured            Boolean  @default(false)
  shareCode           String?  @unique
  title               String
  prompt              String
  content             String
  summary             String?
  /// short | medium | long
  lengthTier          String?  @default("medium")
  /// 长篇流水线元数据 JSON：设定圣经、章规划等（NovelGenerationMeta）
  generationMetaJson  String?
  /// Creative Brief 结构化扩写 JSON
  creativeBriefJson   String?
  /// 角色资产库 JSON（ComicCharacterRoster）
  characterRosterJson String?
  status              String   @default("ready")
  coverPath           String?
  playCount           Int      @default(0)
  likeCount           Int      @default(0)
  /// 生成该小说时实际命中的服务商 ID
  generationProvider  String?
  /// 生成该小说时实际命中的模型 ID
  generationModel     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  comics Comic[]

  @@index([ownerKey])
  @@index([visibility, featured, playCount])
  @@index([visibility, createdAt])
}

model Comic {
  id                String   @id @default(cuid())
  ownerKey          String
  visibility        String   @default("public")
  featured          Boolean  @default(false)
  novelId           String?
  shareCode         String?  @unique
  title             String
  prompt            String
  imageUrls         String
  /// 漫画改编 Brief JSON（可与关联 Novel 的 Brief 并存）
  creativeBriefJson String?
  status            String   @default("ready")
  coverPath         String?
  likeCount         Int      @default(0)
  /// 生成该漫画分镜时实际命中的服务商 ID
  generationProvider String?
  /// 生成该漫画分镜时实际命中的模型 ID
  generationModel    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  novel Novel? @relation(fields: [novelId], references: [id], onDelete: SetNull)

  @@index([ownerKey])
  @@index([novelId])
  @@index([visibility, featured, likeCount])
  @@index([visibility, createdAt])
}

/// 用户评论（game / novel / comic 三类内容通用；匿名 ownerKey 识别作者）
model Comment {
  id        String   @id @default(cuid())
  /// "game" | "novel" | "comic"
  workType  String
  workId    String
  /// 匿名作者标识（来自 gcreator_owner cookie）
  ownerKey  String
  /// 显示昵称（未登录时默认"访客"）
  nickname  String   @default("访客")
  content   String
  createdAt DateTime @default(now())

  @@index([workType, workId, createdAt])
  @@index([ownerKey])
}

/// 生成失败日志：game / novel / comic 三类内容的生成错误记录
model GenerationError {
  id            String   @id @default(cuid())
  /// 内容类型：game | novel | comic
  contentType   String
  /// 触发生成的 prompt 前 512 字符（便于统计高频失败主题）
  promptSnippet String
  /// 错误类型标签：timeout | rate_limit | context_length | parse_error | upstream | unknown
  errorType     String   @default("unknown")
  /// 原始错误消息（截断至 512 字符）
  errorMessage  String?
  ownerKey      String?
  createdAt     DateTime @default(now())

  @@index([contentType, createdAt])
  @@index([errorType, createdAt])
  @@index([createdAt])
}
